extends ../layout.pug

block append meta
  meta(property="og:title" content=__('views.transactions-graph') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('transactions-graph.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonicalUrl)

  title= __('views.transactions-graph') + ' | ' + proj_name
  meta(name="description" content=__('transactions-graph.meta.description'))
  meta(name="keywords" content=__('transactions-graph.meta.keywords'))

  script(src='/scripts/vendors/gitgraph.edited.js')

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ../components/shared/breadcrumbs/breadcrumbs.pug

  h1= __('transactions-graph.title')

  nav#transactions-graph-submenu(aria-label=__('transactions-graph.submenu.title'))
    span.submenu-title= __('transactions-graph.submenu.title')
    div#transactions-graph-submenu-links

  div#transactions-graph-container(data-empty-message=__('transactions-graph.empty'))

block column 
  include ../components/shared/column/column.pug