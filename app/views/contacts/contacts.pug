extends ../layout.pug

block append meta
  meta(property="og:title" content=__('views.contacts') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('contacts.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonicalUrl)

  title= __('views.contacts') + ' | ' + proj_name
  meta(name="description" content=__('contacts.meta.description'))
  meta(name="keywords" content=__('contacts.meta.keywords'))

  link(rel="canonical", href=canonicalUrl)
  each link in hreflangs
    link(rel="alternate", hreflang=link.lang, href=link.url)

block main
  include ../components/shared/breadcrumbs/breadcrumbs.pug

  h1= __('contacts.title')

  section#contacts-intro
    p.lead= __('contacts.intro')

  section#contacts-channels
    article.contact-card
      h2= __('contacts.channels.email.title')
      p= __('contacts.channels.email.description')
      a.btn.primary(href='mailto:info@flow-otter.com', title=__('contacts.channels.email.cta'))= __('contacts.channels.email.cta')

    article.contact-card
      h2= __('contacts.channels.telegram.title')
      p= __('contacts.channels.telegram.description')
      a.btn.secondary(href='https://t.me/flow_otter', target='_blank', rel='noopener noreferrer', title=__('contacts.channels.telegram.cta'))= __('contacts.channels.telegram.cta')

    article.contact-card
      h2= __('contacts.channels.facebook.title')
      p= __('contacts.channels.facebook.description')
      a.btn.tertiary(href='https://facebook.com/flow-otter', target='_blank', rel='noopener noreferrer', title=__('contacts.channels.facebook.cta'))= __('contacts.channels.facebook.cta')

  section#contacts-help
    h2= __('contacts.help.title')
    ul
      li= __('contacts.help.item1')
      li= __('contacts.help.item2')
      li= __('contacts.help.item3')

