- 
  let links = [
    {
      id: 'home',
      name: __('views.home'),
      url: '/'
    },
    {
      id: 'transactions-table',
      name: __('views.transactions-table'),
      url: '/transactions-table'
    },
    {
      id: 'transactions-graph',
      name: __('views.transactions-graph'),
      url: '/transactions-graph'
    },
    {
      id: 'contacts',
      name: __('views.contacts'),
      url: '/contacts'
    }
  ] 
span(class="hamburger icon-menu") 
nav(id="main-menu")
  div
    span(class="close icon-close")
    ul
      each link in links
        li(class = (id === link.id) ? "active" : "")
          if link.class
            span(class=link.class)
          a(href='/'+locale + link.url, title=link.name) #{link.name}
  